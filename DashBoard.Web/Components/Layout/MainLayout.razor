@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider Style="@(_headerCollapsed ? "margin-top: 40px;" : "margin-top: 56px;")" />



<div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 16px;">
 
    <MudImage Alt="Логотип" Width="150" Height="40" Src="Images/logo.svg"
              Style="@(_isDarkMode ? "filter: invert(1) brightness(0.9);" : "")" />

 
    <div style="display: flex; gap: 4px; align-items: center;">
        @if (!_headerCollapsed)
        {
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           OnClick="ToggleTheme" Color="Color.Inherit" Size="Size.Small" />

            @if (!_isLoggedIn)
            {
                <MudButton Href="/login" Size="Size.Small">Войти</MudButton>
                <MudButton Href="/register" Size="Size.Small">Регистрация</MudButton>
            }
            else
            {
                <MudText Class="mx-1"><b>@_userName</b></MudText>
                <MudButton OnClick="Logout" Size="Size.Small" Color="Color.Error">Выйти</MudButton>
            }
        }

        <MudIconButton Icon="@(_headerCollapsed ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowUp)"
                       OnClick="ToggleHeader" Color="Color.Inherit" Size="Size.Small" />
    </div>
</div>
<MudLayout Style="@(_headerCollapsed ? "margin-top: 40px;" : "margin-top: 56px;")">
    @if (_isLoggedIn)
    {
        <MudDrawer @bind-Open="@_openStart" Style="height:fit-content;" Anchor="Anchor.Start" Elevation="0" Variant="@DrawerVariant.Persistent">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">@Departs.Departsfirst</MudText>
            </MudDrawerHeader>
            <MudNavMenu Style="height:auto;max-height:none;">
                <MudNavLink Href="/AnalyticHome" Icon="">@Departs.Home @Departs.Departsfirst1</MudNavLink>
            </MudNavMenu>
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">@Departs.DepartsSecond</MudText>
            </MudDrawerHeader>
            <NavMenu />
        </MudDrawer>

        <MudDrawer Style="height:fit-content;" @bind-Open="@_openEnd" Anchor="Anchor.End" Elevation="0" Variant="@DrawerVariant.Persistent">
           
                <MudNavMenu Style="height:auto;max-height:none;">
                <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">Профиль</MudNavLink>
                <MudNavLink Href="/events" Icon="@Icons.Material.Filled.EventNote">Лента событий</MudNavLink>
                <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat">Чат</MudNavLink>
               
                </MudNavMenu>
           
        </MudDrawer>
           
        @if (_isLoggedIn)
        {
            <div style="position: fixed; top: 56px; left: 0; right: 0; z-index: 1; display: flex; justify-content: center; background: var(--mud-palette-background); padding: 4px 0;">
                <MudButton Color="Color.Inherit" OnClick="@ToggleStartDrawer"
                           StartIcon="@(Rtl ? Icons.Material.Filled.East : Icons.Material.Filled.West)"
                           Size="Size.Small" Class="mx-2">
                    Отделы
                </MudButton>
                <MudButton Color="Color.Inherit" OnClick="@ToggleEndDrawer"
                           EndIcon="@(Rtl ? Icons.Material.Filled.West : Icons.Material.Filled.East)"
                           Size="Size.Small" Class="mx-2">
                    Комьюнити
                </MudButton>
            </div>
        }

       
    }

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private bool _isDarkMode = false;
    private bool _openStart = false;
    private bool _openEnd = false;
    private string? _userName;
    private bool _isLoggedIn;
    private bool _headerCollapsed;

    private void ToggleHeader()
    {
        _headerCollapsed = !_headerCollapsed;
    }
    private MudTheme _customTheme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976d2",
            Secondary = "#26a69a",
            AppbarBackground = "#ffffff",
            Background = "#f5f5f5"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#90caf9",
            Secondary = "#80cbc4",
            AppbarBackground = "#1e1e1e",
            Background = "#121212"
        }
    };
    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await JSRuntime.InvokeVoidAsync("eval", $"localStorage.setItem('theme', '{(_isDarkMode ? "dark" : "light")}')");
    }

    [CascadingParameter]
    public bool Rtl { get; set; }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedTheme = await JSRuntime.InvokeAsync<string>("eval", "localStorage.getItem('theme')");
                _isDarkMode = savedTheme == "dark";

                var token = await JSRuntime.InvokeAsync<string>("eval", "localStorage.getItem('authToken')");
                _isLoggedIn = !string.IsNullOrEmpty(token);

                if (_isLoggedIn)
                {
                    _userName = await JSRuntime.InvokeAsync<string>("eval", "localStorage.getItem('userName')");

                   
                    if (NavigationManager.Uri.EndsWith("/") || NavigationManager.Uri.EndsWith("/index"))
                    {
                        NavigationManager.NavigateTo("/events");
                    }
                }

                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("eval", "localStorage.removeItem('authToken'); localStorage.removeItem('userName')");
        _isLoggedIn = false;
        _userName = null;
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private void ToggleStartDrawer() => _openStart = !_openStart;
    private void ToggleEndDrawer() => _openEnd = !_openEnd;
}