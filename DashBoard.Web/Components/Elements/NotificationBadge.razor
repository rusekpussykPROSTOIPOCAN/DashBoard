@inject HttpClient Http
@using System.Threading
@implements IDisposable
@inject IJSRuntime JSRuntime
@if (_count > 0)
{
    <MudBadge Content="@_count" Color="Color.Error" Overlap="true">
        <MudIconButton Icon="@Icons.Material.Filled.Chat" Href="/chat" />
    </MudBadge>
}
else
{
    <MudIconButton Icon="@Icons.Material.Filled.Chat" Href="/chat" />
}

@code {
    private int _count;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _timer = new Timer(async _ =>
        {
            await CheckNewMessages();
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(3));
    }

    private async Task CheckNewMessages()
    {
        try
        {
            var lastCheck = await JSRuntime.InvokeAsync<string>("eval", "localStorage.getItem('lastChatCheck')");
            var url = $"http://api:8080/api/chat/count?since={lastCheck}";
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChatCountResult>();
                _count = result?.Count ?? 0;
                StateHasChanged();
            }
        }
        catch { }
    }

    public void Dispose() => _timer?.Dispose();

    public class ChatCountResult
    {
        public int Count { get; set; }
    }
}