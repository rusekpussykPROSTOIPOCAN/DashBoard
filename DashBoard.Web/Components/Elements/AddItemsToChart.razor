@inject Services.ApiService api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudButton Variant="Variant.Filled" OnClick="OpenDialog">
    <MudIcon Icon="@Icons.Material.Filled.Edit" />
</MudButton>

@code {
    private List<RobotPeriods>? Periods = new();
    private RobotPeriods selected = new();
    private IEnumerable<IGrouping<int, RobotPeriods>> GroupByYears => Periods.GroupBy(x => x.Year);
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public List<UniversalChartItemV3> items { get; set; } = new();
    private string key = "";
    [Parameter] public List<UniversalChartResponseV3> respounse { get; set; } = new();
    [Parameter] public UniversalChartResponseV3 DataResponse { get; set; } = new();
    [Parameter] public int robotId { get; set; }
    [Parameter] public string block { get; set; } = "";

    private async Task OpenDialog()
    {
        var parameters = new DialogParameters
        {
            { "Periods", Periods },
            { "RobotId", robotId },
            { "Block", block },
            { "DataResponse", DataResponse },
            { "Items", items },
            { "GroupByYears", GroupByYears }
        };

        var dialog = await DialogService.ShowAsync<EditChartDialog>("Редактирование данных", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnSave.InvokeAsync();
        }
    }

    private async Task LoadPeriods()
    {
        Periods = await api.GetAsync<List<RobotPeriods>>(
            $"/api/date-controller?idRobot={robotId}"
        );
        key = respounse.FirstOrDefault()?.Title;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPeriods();
    }
}