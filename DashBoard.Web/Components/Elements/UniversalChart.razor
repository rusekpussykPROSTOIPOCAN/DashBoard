@inject HttpClient Http
@inject Services.ApiService api
@using NormalizeRobots
@inject ISnackbar Snackbar

<MudPaper Class="pa-4">

    @if (Data is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudStack Spacing="2">
            <AddItemsToChart Items="Data.Items" robotId="Data.RobotId" block="@Data.Block" OnSave="HandleSave" DataResponse="Data" />
            <MudText><b>Робот:</b> @Data.RobotName</MudText>
            <MudText><b>Задача: </b>@NormalizeRobots.NormalizerRobots.Block(Data.Block)</MudText>
            <MudText><b>Сумма:</b> @Data.Total</MudText>
            
            @if (Data.Items.Count <= 1)
            {
               
            }
            else if (Data.Type == ChartTypeRobot.Table)
            {
                <MudTable Items="Data.Items">
                    <HeaderContent>
                        <MudTh>Название</MudTh>
                        <MudTh>Значение</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@NormalizeRobots.NormalizerRobots.Normalizer(Data.Block, context.Key)</MudTd>
                        <MudTd>@context.Value</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudChart ChartType="@Map(Data.Type)"
                          ChartLabels="_labels"
                          ChartSeries="_values.AsChartDataSet()"
                          Height="@($"{height}px")" />
            }
            
            <MudIconButton OnClick="() => DeleteRobot(Data.RobotId)"
                           Icon="@Icons.Material.Filled.Delete"
                           Disabled="_isDeleting" />
        </MudStack>
    }

</MudPaper>

@code {
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public UniversalChartResponseV3 Data { get; set; }
    [Parameter] public int height { get; set; } = 350;

    private string[] _labels = [];
    private double[] _values = [];
    private bool _isDeleting;

    protected override void OnParametersSet()
    {
        if (Data?.Items != null)
        {
            var items = Data.Items.ToList();
            _labels = items.Select(x => NormalizerRobots.Normalizer(Data.Block, x.Key)).ToArray();
            _values = items.Select(x => x.Value).ToArray();
        }
        else
        {
            _labels = [];
            _values = [];
        }
    }

    private ChartType Map(ChartTypeRobot type) => type switch
    {
        ChartTypeRobot.Bar => ChartType.Bar,
        ChartTypeRobot.Pie => ChartType.Pie,
        ChartTypeRobot.Line => ChartType.Line,
        _ => ChartType.Bar
    };

    private async Task HandleSave()
    {
        await OnSave.InvokeAsync();
    }

    private async Task DeleteRobot(int id)
    {
        _isDeleting = true;
        try
        {
            await api.DeleteAsync($"api/robot-delete/{id}");
            Snackbar.Add("Робот удален", Severity.Success);
        
            
            if (OnSave.HasDelegate)
            {
                await OnSave.InvokeAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"Ошибка при удалении: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка при удалении: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDeleting = false;
        }
    }
}