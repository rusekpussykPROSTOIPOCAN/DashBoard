@inject HttpClient Http
@inject Services.ApiService api


<MudPaper Class="pa-4">

    @if (Data is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudStack Spacing="2">
            <AddItemsToChart Items="Data.Items" robotId="Data.RobotId" block="@Data.Block" OnSave="OnSave" DataResponse="Data"/>
                <MudText><b>Робот:</b> @Data.RobotName</MudText>
            <MudText><b>Задача: </b>@NormalizeRobots.NormalizerRobots.Block(Data.Block)</MudText>
                <MudText><b>Сумма:</b> @Data.Total</MudText>
           @if (Data.Items.Count <= 1)
            {
            }
            else if (Data.Type == ChartTypeRobot.Table)
            {
         
                <MudTable Items="Data.Items">
                    <HeaderContent>
                        <MudTh>Название</MudTh>
                        <MudTh>Значение</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@NormalizeRobots.NormalizerRobots.Key(context.Key)</MudTd>
                        <MudTd>@context.Value</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
            
                <MudChart ChartType="@Map(Data.Type)"
                          ChartLabels="_labels"
                          ChartSeries="_values.AsChartDataSet()"
                          Height="@($"{height}px")" />
            }

        </MudStack>
    }

</MudPaper>
@code {

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public UniversalChartResponseV3 Data { get; set; }
    [Parameter] public int height { get; set; } = 350;

    private string[] _labels = [];
    private double[] _values = [];

    protected override void OnParametersSet()
    {
        if (Data?.Items != null)
        {
            var items = Data.Items.ToList();

            _labels = items.Select(x => NormalizeRobots.NormalizerRobots.Key(x.Key)).ToArray();
            _values = items.Select(x => x.Value).ToArray();
        }
        else
        {
            _labels = [];
            _values = [];
        }
    }

    private ChartType Map(ChartTypeRobot type) => type switch
    {
        ChartTypeRobot.Bar =>ChartType.Bar,
        ChartTypeRobot.Pie =>ChartType.Pie,
        ChartTypeRobot.Line =>ChartType.Line,
        _ => ChartType.Bar
    };
}