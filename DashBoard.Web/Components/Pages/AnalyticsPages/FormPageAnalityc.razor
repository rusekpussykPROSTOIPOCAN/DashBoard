@page "/EditAnaliticForm/{id:int}"
@inject Services.ApiService api
@using MudBlazor
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <MudText Typo="Typo.h4" Class="mb-4">
        @(_isEdit ? "Редактирование задачи" : "Новая задача")
    </MudText>

    <MudStack Spacing="3">
        <MudSelect T="int"
                   Label="Источник"
                   @bind-Value="_formData.IdSourse"
                   Required="true">
            @foreach (var source in _sources)
            {
                <MudSelectItem Value="@source.Id">@source.Name</MudSelectItem>
            }
        </MudSelect>
        
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_formData.AllPerimeter"
                              Label="Всего периметр"
                              InputType="InputType.Number"
                              OnBlur="RecalculatePerimeter" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_formData.CompletePerimeter"
                              Label="Выполненный периметр"
                              InputType="InputType.Number"
                              OnBlur="RecalculatePerimeter" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_formData.RemainedPerimeter"
                              Label="Оставшийся периметр"
                              InputType="InputType.Number"
                              OnBlur="RecalculatePerimeter" />
            </MudItem>
        </MudGrid>
        
        <MudTextField @bind-Value="_formData.Comment"
                      Label="Комментарий"
                      Lines="3" />
        
        <MudText Typo="Typo.subtitle1"><b>Нарушения:</b></MudText>
        
        @for (int i = 0; i < _formData.Violations.Count; i++)
        {
            var index = i;
            <MudPaper Elevation="2" Class="pa-3 mb-2">
                <MudGrid>
                    <MudItem xs="12" md="5">
                        <MudSelect T="int"
                                   Label="Статья"
                                   @bind-Value="_formData.Violations[index].IdArticle"
                                   Required="true">
                            @foreach (var article in _articles)
                            {
                                <MudSelectItem Value="@article.Id">@article.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudTextField @bind-Value="_formData.Violations[index].ViolationsWeek"
                                      Label="За неделю"
                                      InputType="InputType.Number"
                                      OnBlur="@(() => RecalculateViolation(index))" />
                    </MudItem>
                    <MudItem xs="6" md="2">
                        <MudTextField @bind-Value="_formData.Violations[index].NewViolations"
                                      Label="Новых"
                                      InputType="InputType.Number"
                                      OnBlur="@(() => RecalculateViolation(index))" />
                    </MudItem>
                  
                    <MudItem xs="6" md="1" Class="d-flex align-end">
                        <MudTextField @bind-Value="_formData.Violations[index].OldViolations"
                                      Label="Старых"
                                      InputType="InputType.Number"
                                      OnBlur="@(() => RecalculateViolation(index))" />
                    </MudItem>
                    <MudItem xs="6" md="1" Class="d-flex align-end">
                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => RemoveViolation(index))" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
      
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Info"
                   OnClick="AddViolation"
                   StartIcon="@Icons.Material.Filled.Add">
            Добавить нарушение
        </MudButton>
       
            
        
        <div class="d-flex gap-2 justify-end">
            <MudButton Variant="Variant.Outlined" OnClick="GoBack">Отмена</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Сохранить</MudButton>
        </div>
    </MudStack>
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }
    
    private bool _isEdit;
    private AddWorkProgressRequest _formData = new() { Violations = new() };
    
    private List<(int Id, string Name)> _articles = new();
    private List<(int Id, string Name)> _sources = new();

    private void RecalculatePerimeter()
    {
        if (_formData.AllPerimeter > 0 && _formData.CompletePerimeter > 0)
        {
            _formData.RemainedPerimeter = _formData.AllPerimeter - _formData.CompletePerimeter;
        }
        else if (_formData.AllPerimeter > 0 && _formData.RemainedPerimeter > 0)
        {
            _formData.CompletePerimeter = _formData.AllPerimeter - _formData.RemainedPerimeter;
        }
        else if (_formData.CompletePerimeter > 0 && _formData.RemainedPerimeter > 0)
        {
            _formData.AllPerimeter = _formData.CompletePerimeter + _formData.RemainedPerimeter;
        }
        StateHasChanged();
    }

    private void RecalculateViolation(int index)
    {
        var v = _formData.Violations[index];

        if (v.ViolationsWeek > 0 && v.NewViolations > 0)
        {
            v.OldViolations = v.ViolationsWeek - v.NewViolations;
        }
        else if (v.ViolationsWeek > 0 && v.OldViolations > 0)
        {
            v.NewViolations = v.ViolationsWeek - v.OldViolations;
        }
        else if (v.NewViolations > 0 && v.OldViolations > 0)
        {
            v.ViolationsWeek = v.NewViolations + v.OldViolations;
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _isEdit = Id > 0;
        await LoadReferenceData();
        
        if (_isEdit)
        {
            await LoadWorkProgress();
        }
    }

    private async Task LoadReferenceData()
    {
        try
        {
           
            var articles = await api.GetAsync<List<ArticleDto>>("api/articles");
            _articles = articles?.Select(a => (a.Id, a.Article1 ?? "Неизвестно")).ToList() ?? new();

            var sources = await api.GetAsync<List<SourceDto>>("api/sources");
            _sources = sources?.Select(s => (s.Id, s.Source ?? "Неизвестно")).ToList() ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки данных: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadWorkProgress()
    {
        try
        {
            var data = await api.GetAsync<WorkProgressResponce>($"api/form/{Id}");
            if (data != null)
            {
                 var userId = await JSRuntime.GetUserId();
                _formData = new AddWorkProgressRequest
                {
                    IdSourse = data.IdSourse,
                    AllPerimeter = data.AllPerimeter,
                    CompletePerimeter = data.CompletePerimeter,
                    RemainedPerimeter = data.RemainedPerimeter,
                    Comment = data.Comment,
                    UserId = userId,
                    Violations = data.Violations.Select(v => new ViolationRequest
                    {
                        IdArticle = v.IdArticle,
                        ViolationsWeek = v.ViolationsWeek,
                        NewViolations = v.NewViolations,
                        OldViolations = v.OldViolations
                    }).ToList()
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки задачи: {ex.Message}", Severity.Error);
        }
    }

    private void AddViolation()
    {
        _formData.Violations.Add(new ViolationRequest());
    }

    private void RemoveViolation(int index)
    {
        if (_formData.Violations.Count > 1)
        {
            _formData.Violations.RemoveAt(index);
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        try
        {
            if (_formData.IdSourse <= 0)
            {
                Snackbar.Add("Выберите источник", Severity.Warning);
                return;
            }

            if (!_formData.Violations.Any())
            {
                Snackbar.Add("Добавьте хотя бы одно нарушение", Severity.Warning);
                return;
            }

            if (_isEdit)
            {
                var userId = await JSRuntime.GetUserId();
                var updateRequest = new EditWorkProgressRequest
                {
                    Id = Id,
                    IdSourse = _formData.IdSourse,
                    AllPerimeter = _formData.AllPerimeter,
                    CompletePerimeter = _formData.CompletePerimeter,
                    RemainedPerimeter = _formData.RemainedPerimeter,
                    Comment = _formData.Comment,
                    Violations = _formData.Violations,
                    UserId = userId
                };
                await api.PutAsync<object>($"api/form/{Id}", updateRequest);
            }
            else
            {
                await api.PostAsync<AddWorkProgressResult>("api/form", _formData);
            }
            
            Snackbar.Add(_isEdit ? "Задача обновлена" : "Задача создана", Severity.Success);
            Navigation.NavigateTo("/AnalyticHome");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка сохранения: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/AnalyticHome");
    }


}