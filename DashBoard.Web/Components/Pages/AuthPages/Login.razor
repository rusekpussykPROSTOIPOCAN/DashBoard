@page "/login"
@inject Services.ApiService api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime


<MudContainer MaxWidth="MaxWidth.Small">
    <MudCard Class="mt-10 pa-5">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-4">Вход в систему</MudText>

            <MudTextField @bind-Value="_email" Label="Email" />
            <MudTextField @bind-Value="_password" Label="Пароль" InputType="InputType.Password" />
            <MudCheckBox T="string" @bind-Checked="_rememberMe" Label="Запомнить меня" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleLogin" Class="mt-4" FullWidth="true">
                Войти
            </MudButton>

           
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string _email = "";
    private string _password = "";
    private bool _rememberMe;

    private async Task HandleLogin()
    {
        var data = new { email = _email, password = _password, rememberMe = _rememberMe };

        try
        {
            var result = await api.PostAsync<LoginResult>("api/auth/login", data); 

            if (result != null && !string.IsNullOrEmpty(result.Token))
            {
                await JSRuntime.InvokeVoidAsync("eval", $"sessionStorage.setItem('department', '{result?.Department}')");
                await JSRuntime.InvokeVoidAsync("eval", $"sessionStorage.setItem('role', '{result?.Roles?.FirstOrDefault()}')");
                await JSRuntime.InvokeVoidAsync("eval", $"sessionStorage.setItem('authToken', '{result.Token}')");
                await JSRuntime.InvokeVoidAsync("eval", $"sessionStorage.setItem('userName', '{result.FullName}')");
                await JSRuntime.InvokeVoidAsync("eval", $"sessionStorage.setItem('userId', '{result.UserId}')");
                await JSRuntime.InvokeVoidAsync("eval", $"sessionStorage.setItem('email', '{result.Email}')");

                Snackbar.Add($"Добро пожаловать, {result.FullName}!", Severity.Success);
                if(result.Roles.FirstOrDefault() == "Сотрудник")
                {
                    
                Navigation.NavigateTo("/my-tasks", forceLoad: true);
                }
                if(result.Roles.FirstOrDefault() == "Руководитель")
                {
                            Navigation.NavigateTo("/events", forceLoad: true);
                }
                if(result.Roles.FirstOrDefault() == "Администратор")
                {
                    Navigation.NavigateTo("/events", forceLoad: true);
                }
                
            }
        }
        catch
        {
            Snackbar.Add("Неверный email или пароль", Severity.Error);
        }
    }

    public class LoginResult
    {
        public bool Success { get; set; }
        public string? Token { get; set; }
        public string? Email { get; set; }
        public string? Department { get; set; }

        public string? FullName { get; set; }
        public string? UserId { get; set; }
        public List<string>? Roles { get; set; }
    }
}