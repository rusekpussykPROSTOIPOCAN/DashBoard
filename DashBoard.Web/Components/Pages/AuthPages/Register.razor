@page "/register"
@inject Services.ApiService api
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using System.Text
@using System.Text.Json

<MudContainer MaxWidth="MaxWidth.Small">
    <MudCard Class="mt-10 pa-5">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-4">Регистрация</MudText>

            <MudTextField @bind-Value="_fullName" Label="ФИО" />
            <MudTextField @bind-Value="_email" Label="Email" />
            <MudTextField @bind-Value="_password" Label="Пароль" InputType="InputType.Password" />
            <MudSelect @bind-Value="_department" Label="Отдел">
                @foreach(var dep in _departs)
                {
                    <MudSelectItem Value="dep">@dep</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleRegister" Class="mt-4" FullWidth="true">
                Зарегистрироваться
            </MudButton>

           
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string _fullName = "";
    private string _email = "";
    private string _password = "";
    private string _department = "";


    private readonly string[] _departs = { "ДКН", "Аналитика" };
    private async Task HandleRegister()
    {
        try
        {
            var data = new { email = _email, password = _password, fullName = _fullName, department = _department };
            await api.PostAsync<object>("api/auth/register", data); 
            Snackbar.Add("Регистрация успешна! Проверьте почту.", Severity.Success);
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }
}