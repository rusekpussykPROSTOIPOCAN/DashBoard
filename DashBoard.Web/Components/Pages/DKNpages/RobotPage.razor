@page "/robot"
@inject IDialogService DialogService
@inject Services.ApiService api
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
<PageTitle>@Departs.Robots</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudGrid>
        <MudItem sm="6" xs="12">
            
            @if (_useDateRange)
            {
                <MudDateRangePicker 
                                    Label="Выберите период"
                                    DateFormat="dd.MM.yyyy"
                                    Clearable="true"
                                    DateRangeChanged="OnDateRangeChanged" />
                <MudButton Size="Size.Small" OnClick="SwitchFilter">Период (год/месяц/квартал)</MudButton>
            }
            else
            {
                <DialogPer OnChange="OnPeriodChanged" />
                <MudButton Size="Size.Small" OnClick="SwitchFilter">Календарь</MudButton>
            }
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="ExportRobots">
                
            </MudButton>
        </MudItem>
        
        <MudItem sm="3" xs="6">
            <MudAutocomplete T="RobotDto" Clearable="true"
                             Label="Робот"
                             SearchFunc="SearchRobots"
                             ToStringFunc="r => r?.Name ?? string.Empty"
                             ValueChanged="OnRobotChanged"
                             MinCharacters="0"
                             ResetValueOnEmptyText="true" />
        </MudItem>
        
        <MudItem md="3" sm="3" Class="d-flex justify-end gap-1">
            <MudButton Href="/AddRobot" StartIcon="@Icons.Material.Filled.Add">Добавить</MudButton>
            @if (_idRobot.HasValue)
            {
                <MudButton OnClick="() => EditRobot(_idRobot.Value)"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Color="Color.Warning">
                    Ред.
                </MudButton>
            }
        </MudItem>

        <MudItem xs="12">
            <MudGrid>
                @foreach (var chart in charts)
                {
                    <MudItem md="6" sm="12" xs="12">
                        <UniversalChart @key="chart.RobotId + '_' + chart.Block"
                                        Data="chart"
                                        OnSave="HandleChartUpdate" />
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private DateRange? _dateRange;
    private bool _useDateRange = true; 
    private int? _year;
    private int? _month;
    private int? _quarter;
    private List<UniversalChartResponseV3> charts = new();
    private int? _idRobot;
    private bool _isLoading;

    private void SwitchFilter()
    {
        _useDateRange = !_useDateRange;
        _dateRange = null;
        _year = null;
        _month = null;
        _quarter = null;
        StateHasChanged();
    }

    private async Task OnDateRangeChanged(DateRange? range)
    {
        _dateRange = range;
        await LoadCharts();
    }

    private async Task ExportRobots()
    {
        try
        {
            var query = GetQueryParams();
            if (_useDateRange && _dateRange?.Start.HasValue == true && _dateRange?.End.HasValue == true)
            {
                query.Add($"dateFrom={_dateRange.Start.Value:yyyy-MM-dd}");
                query.Add($"dateTo={_dateRange.End.Value:yyyy-MM-dd}");
            }
            else
            {
                if (_year.HasValue) query.Add($"year={_year}");
                if (_quarter.HasValue) query.Add($"quarter={_quarter}");
            }
            var url = "api/universal-chart-v3/export-robots-pivot";
            if (query.Any()) url += "?" + string.Join("&", query);

            var result = await api.GetAsync<ExportResult>(url);

            if (result != null && !string.IsNullOrEmpty(result.Base64))
            {
                await JSRuntime.InvokeVoidAsync("downloadFile",
                    result.FileName, result.Base64,
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
                Snackbar.Add("Сводная таблица скачана", Severity.Success);
            }
            else
            {
                Snackbar.Add("Нет данных", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }

    public class ExportResult
    {
        public string Base64 { get; set; } = "";
        public string FileName { get; set; } = "";
    }

    private void EditRobot(int robotId)
    {
        Navigation.NavigateTo($"/EditRobot/{robotId}");
    }

    private async Task<IEnumerable<RobotDto>> SearchRobots(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
            return await api.GetAsync<List<RobotDto>>("api/autocomplete-robots") ?? new();
        
        return await api.GetAsync<List<RobotDto>>($"api/autocomplete-robots?search={value}") ?? new();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCharts();
    }

    private List<string> GetQueryParams()
    {
        var query = new List<string>();

        if (_useDateRange && _dateRange?.Start.HasValue == true && _dateRange?.End.HasValue == true)
        {
            query.Add($"dateFrom={_dateRange.Start.Value:yyyy-MM-dd}");
            query.Add($"dateTo={_dateRange.End.Value:yyyy-MM-dd}");
        }
        else
        {
            if (_year.HasValue) query.Add($"year={_year}");
            if (_month.HasValue) query.Add($"month={_month}");
            if (_quarter.HasValue) query.Add($"quarter={_quarter}");
        }

        if (_idRobot.HasValue) query.Add($"robotId={_idRobot}");

        return query;
    }

    private async Task LoadCharts()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            var query = GetQueryParams();
            var url = "api/universal-chart-v3";
            if (query.Any()) url += "?" + string.Join("&", query);

            var result = await api.GetAsync<List<UniversalChartResponseV3>>(url);
            charts = result?.ToList() ?? new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleChartUpdate()
    {
        await LoadCharts();
    }

    private async Task OnRobotChanged(RobotDto robot)
    {
        _idRobot = robot?.Id;
        await LoadCharts();
    }

    private async Task OnPeriodChanged(DialogPer.Periods periods)
    {
        _year = periods.Year;
        _month = periods.Month;
        _quarter = periods.Quarter;
        await LoadCharts();
    }
}