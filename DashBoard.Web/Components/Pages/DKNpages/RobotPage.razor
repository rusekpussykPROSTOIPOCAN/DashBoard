@page "/robot"
@inject IDialogService DialogService
@inject Services.ApiService api
@inject NavigationManager Navigation
@inject HttpClient httpClient
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
<PageTitle>@Departs.Robots</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudGrid>
        <MudItem sm="3" xs="6">
            <DialogPer OnChange="OnPeriodChanged" />
        </MudItem>
        <MudItem sm="3" xs="6">
            <MudAutocomplete T="RobotDto" Clearable="true"
                             Label="Робот"
                             SearchFunc="SearchRobots"
                             ToStringFunc="r => r?.Name ?? string.Empty"
                             ValueChanged="OnRobotChanged"
                             MinCharacters="0"
                             CoerceValue="false"
                             ResetValueOnEmptyText="true" />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       OnClick="ExportRobots"
                       Class="my-1">
                Excel
            </MudButton>
        </MudItem>
        <MudItem md="6" sm="6" Class="d-flex justify-sm-end justify-center pr-sm-4">
            <MudButton Href="/AddRobot" StartIcon="@Icons.Material.Filled.Add">Добавить робота</MudButton>
            @if (_idRobot.HasValue)
            {
                <MudButton OnClick="() => EditRobot(_idRobot.Value)"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Color="Color.Warning">
                    Редактировать робота
                </MudButton>
            }
        </MudItem>

        <MudItem xs="12">
            <MudGrid>
                @foreach (var chart in charts)
                {
                    <MudItem md="6" sm="12" xs="12">
                        <UniversalChart @key="chart.RobotId + '_' + chart.Block"
                                        Data="chart"
                                        OnSave="HandleChartUpdate" />
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int? _year;
    private int? _month;
    private int? _quarter;
    private List<UniversalChartResponseV3> charts = new();
    private int? _idRobot;
    private bool _isLoading;
    private async Task ExportRobots()
    {
        try
        {
            var query = new List<string>();
            if (_year.HasValue) query.Add($"year={_year}");
            if (_quarter.HasValue) query.Add($"quarter={_quarter}");

            var url = "api/universal-chart-v3/export-robots-pivot";
            if (query.Any()) url += "?" + string.Join("&", query);

            var result = await api.GetAsync<ExportResult>(url);
        
            if (result != null && !string.IsNullOrEmpty(result.Base64))
            {
                await JSRuntime.InvokeVoidAsync("downloadFile",
                    result.FileName, result.Base64,
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
                Snackbar.Add("Сводная таблица скачана", Severity.Success);
            }
            else
            {
                Snackbar.Add("Нет данных", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
    }
    public class ExportResult
    {
        public string Base64 { get; set; } = "";
        public string FileName { get; set; } = "";
    }
    private void EditRobot(int robotId)
    {
        Navigation.NavigateTo($"/EditRobot/{robotId}");
    }

    private async Task<IEnumerable<RobotDto>> SearchRobots(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return await api.GetAsync<List<RobotDto>>("api/autocomplete-robots");
        }
        return await api.GetAsync<List<RobotDto>>(
            $"api/autocomplete-robots?search={value}"
        );
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCharts();
    }

    private async Task LoadCharts()
    {
        if (_isLoading) return;
        
        _isLoading = true;
        try
        {
            var query = new List<string>();

            if (_idRobot.HasValue)
                query.Add($"robotId={_idRobot}");

            if (_year.HasValue)
                query.Add($"year={_year}");

            if (_month.HasValue)
                query.Add($"month={_month}");

            if (_quarter.HasValue)
                query.Add($"quarter={_quarter}");

            var url = "api/universal-chart-v3";

            if (query.Any())
                url += "?" + string.Join("&", query);

            var result = await api.GetAsync<List<UniversalChartResponseV3>>(url);
            
            
            charts = result?.ToList() ?? new List<UniversalChartResponseV3>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleChartUpdate()
    {
        await LoadCharts();
        StateHasChanged();
    }

    private async Task OnRobotChanged(RobotDto robot)
    {
        _idRobot = robot?.Id;
        await LoadCharts();
    }

    private async Task OnPeriodChanged(DialogPer.Periods periods)
    {
        _year = periods.Year;
        _month = periods.Month;
        _quarter = periods.Quarter;
        await LoadCharts();
    }
}