@page "/events"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using System.Text
@inject Services.ApiService api
@using System.Text.Json

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h4" Class="mb-4">Лента событий</MudText>

    
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_search" Placeholder="Поиск..." 
                          Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyUp="OnSearchChanged" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker @bind-Date="_filterDate" Label="Дата" Clearable="true" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Filled" OnClick="ApplyFilters" Size="Size.Small">Показать</MudButton>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Outlined" OnClick="ClearFilters" Size="Size.Small">Сбросить</MudButton>
        </MudItem>
    </MudGrid>

   
    @if (_isLoading)
    {
        @for (int i = 0; i < 5; i++)
        {
            <MudCard Class="mb-2 pa-3">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                    <div style="flex-grow: 1;">
                        <MudSkeleton Width="150px" Height="16px" Class="mb-1" />
                        <MudSkeleton Width="100%" Height="14px" />
                    </div>
                    <MudSkeleton Width="80px" Height="14px" />
                </div>
            </MudCard>
        }
    }
    else if (_filteredEvents.Count == 0)
    {
        <MudCard Class="pa-5">
            <MudText Align="Align.Center" Color="Color.Secondary">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" />
                <br />Нет событий
            </MudText>
        </MudCard>
    }
    else
    {
        
        @foreach (var evt in _filteredEvents)
        {
            <MudCard Class="mb-2" Elevation="1">
                <div style="display: flex; align-items: flex-start; padding: 12px; gap: 12px;">
                    
                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                        @evt.UserName?.FirstOrDefault().ToString().ToUpper()
                    </MudAvatar>
                    
                    <div style="flex-grow: 1;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <MudText Typo="Typo.body2"><b>@evt.UserName</b></MudText>
                            <MudChip T="string" Size="Size.Small" Color="@GetActionColor(evt.Action)" Style="word-break: break-all;">
                                @evt.Action
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Style="word-break: break-all;" Class="mt-1">@evt.Description</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-1" />
                            @evt.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </div>
                </div>
            </MudCard>
        }
        
       
        <div class="d-flex justify-center mt-4">
            <MudPagination Count="@((_filteredEvents.Count + _pageSize - 1) / _pageSize)" 
                           Selected="@((_currentPage))"
                           SelectedChanged="OnPageChanged" />
        </div>
    }

   
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            OnClick="OpenAddEventDialog"
            Style="position: fixed; bottom: 20px; right: 20px;" />

    
    <MudDialog @bind-Visible="_dialogVisible">
        <DialogContent>
            <MudStack Spacing="3">
                <MudText>Добавить событие</MudText>
                <MudTextField @bind-Value="_newEventTitle" Label="Название" />
                <MudTextField @bind-Value="_newEventDescription" Label="Описание" Lines="3" />
                <MudDatePicker @bind-Date="_newEventDate" Label="Дата" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _dialogVisible = false">Отмена</MudButton>
            <MudButton Color="Color.Primary" OnClick="SaveEvent">Добавить</MudButton>
        </DialogActions>
    </MudDialog>
</MudContainer>

@code {
    private List<EventLogItem> _events = new();
    private List<EventLogItem> _filteredEvents = new();
    private string _search = "";
    private DateTime? _filterDate;
    private bool _isLoading = true;
    private bool _dialogVisible;
    private string _newEventTitle = "";
    private string _newEventDescription = "";
    private DateTime? _newEventDate = DateTime.Today;
    private int _pageSize = 10;
    private int _currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        _isLoading = true;
        StateHasChanged();
        
        var result = await api.GetAsync<List<EventLogItem>>("api/events");
        _events = result ?? new();
        ApplyFilters();
        
        _isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        var query = _events.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.ToLower();
            query = query.Where(e =>
                (e.UserName?.ToLower().Contains(s) == true) ||
                (e.Action?.ToLower().Contains(s) == true) ||
                (e.Description?.ToLower().Contains(s) == true));
        }

        if (_filterDate.HasValue)
            query = query.Where(e => e.CreatedAt.Date == _filterDate.Value.Date);

        _filteredEvents = query.OrderByDescending(e => e.CreatedAt).ToList();
        _currentPage = 1;
    }

    private void OnSearchChanged() => ApplyFilters();
    private void OnFilterDateChanged(DateTime? date) { _filterDate = date; ApplyFilters(); }
    private void ClearFilters() { _search = ""; _filterDate = null; ApplyFilters(); }
    private void OnPageChanged(int page) => _currentPage = page;

    private Color GetActionColor(string action) => action switch
    {
        "Создание задачи" => Color.Success,
        "Удаление задачи" => Color.Error,
        "Обновление задачи" => Color.Warning,
        "Создание робота" => Color.Info,
        "Регистрация" => Color.Primary,
        _ => Color.Default
    };

    private void OpenAddEventDialog()
    {
        _newEventTitle = "";
        _newEventDescription = "";
        _newEventDate = DateTime.Today;
        _dialogVisible = true;
    }

    private async Task SaveEvent()
    {
        try
        {
            var userId = await JSRuntime.GetUserId();
            var request = new
            {
                userId = userId,
                title = _newEventTitle,
                description = _newEventDescription,
                eventDate = (_newEventDate ?? DateTime.Today).ToString("yyyy-MM-dd")  
            };
            await api.PostAsync<object>("api/calendar/events", request);
            _dialogVisible = false;
            await LoadEvents();
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    public class EventLogItem
    {
        public string UserName { get; set; } = "";
        public string Action { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime CreatedAt { get; set; }
    }
}